PORT=3000
USERNAME=admin
PASSWORD=change-me

# Optional: default max size (MB) for a single uploaded file. Default 5120 (5GB).
# Individual shares can override this from the admin UI.
# MAX_UPLOAD_MB=5120

# Optional: where .state.json (share list + passwords) is stored.
# Set this when running in Docker so it persists on a mounted volume.
# DATA_DIR=/data
